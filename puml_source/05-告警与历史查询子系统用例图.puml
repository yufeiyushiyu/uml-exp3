@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam backgroundColor white
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F2F6FC
  BorderColor #4A6FA5
  ArrowColor #4A6FA5
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #9DB2C8
}
left to right direction
actor "运维工程师" as Ops
actor "系统管理员" as Admin

rectangle "告警与历史查询子系统" {
  usecase "配置阈值告警规则" as UC1
  usecase "接收告警事件" as UC2
  usecase "查看告警列表" as UC3
  usecase "确认并处置告警" as UC4
  usecase "按时间范围查询读数" as UC5
  usecase "绘制趋势曲线" as UC6
  usecase "导出查询结果" as UC7
}

Admin --> UC1
Ops --> UC3
Ops --> UC4
Ops --> UC5
UC5 ..> UC6 : <<include>>
UC3 ..> UC2 : <<include>>
UC4 <.. UC7 : <<extend>>
@enduml
